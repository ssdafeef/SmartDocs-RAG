# ==============================================================================
# SmartDocs - AI-Powered Document Research Assistant Environment Configuration
# ==============================================================================

# Google Gemini API Key (Required for LLM response generation)
# Get your API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Model Name
GEMINI_MODEL=gemini-2.5-flash

# Embeddings Model (Sentence Transformers)
# Default: all-MiniLM-L6-v2 (compact, fast 384-dimensional embeddings)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# RAG Document Chunking Configuration
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# Semantic Search & Retrieval
TOP_K_RETRIEVAL=4
SIMILARITY_THRESHOLD=0.2

# Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Storage Paths
STORAGE_DIR=./storage
UPLOADS_DIR=./storage/uploads
VECTOR_STORE_DIR=./storage/vector_store
